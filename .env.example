# Secret that protects the MCP endpoint and the token upload endpoint.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# Upstash Redis (Vercel Marketplace -> Storage -> Upstash for Redis).
# Vercel injects these automatically once the store is connected to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Your timezone, used to resolve "today" (IANA name).
GARMIN_TIMEZONE=Europe/Lisbon

# Set to "true" to expose tools that change data in Garmin Connect
# (create / schedule / delete workouts). Off by default.
GARMIN_ENABLE_WRITE=false

# Optional fallback when no Redis is configured: the contents of
# garmin_tokens.json (raw JSON or base64). Refreshed tokens are then kept in
# memory only, so Redis is strongly recommended.
GARMIN_TOKENS=
